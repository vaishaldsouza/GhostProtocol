# ──────────────────────────────────────────────
# RedPulse AI — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ──────────────────────────────────────────────

# ── Supabase (required for auth, donor data, predictions)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Gmail SMTP — Free email sending via Nodemailer
# Get App Password: myaccount.google.com/apppasswords
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME=RedPulse Emergency

# ── Bland.ai — Free AI voice calls (1000 min/month free)
# Get key at: app.bland.ai
BLAND_API_KEY=org_your_key_here

# ── Meta WhatsApp Business API (optional — premium)
VITE_META_WHATSAPP_TOKEN=
VITE_META_PHONE_NUMBER_ID=

# ── Twilio WhatsApp Sandbox (optional)
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Twilio Voice API (optional — used by Python backend)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=

# ── Resend Email API (optional — replaced by Gmail SMTP)
VITE_RESEND_API_KEY=
VITE_RESEND_FROM_EMAIL=

# ── Murf AI — Professional AI voice generation (optional)
# Get key at: https://murf.ai/
MURF_API_KEY=
MURF_VOICE_ID=

# ── Gemini 2.5 Flash — AI responses (optional)
# Get key at: https://ai.google.dev/
GEMINI_API_KEY=

# ── Express Gateway port (default: 3001)
WHATSAPP_SERVER_PORT=3001
